// =============================================================================
// S-CODE SAMPLE - DEBOUNCED BUTTONS
// =============================================================================
// What it does:
//   Debounces six active-low buttons and reports one event per physical press.
// Expected result:
//   Pressing buttons 1 through 6 produces LED values 1 through 6; releasing all
//   buttons clears the LEDs.
// Runs on:
//   S-CPU TTL with the physical input board connected to device 3.
// Real hardware required:
//   Yes. The input board is not emulated by the software simulators.
// Demonstrates:
//   Buttons library initialization, stable reads, pressed edges, and MMIO.
// =============================================================================

#include "io/DigitalRead"
#include "io/DigitalWrite"
#include "io/Buttons"

// DigitalRead/Write add the IODEV base internally, so these are MMIO offsets.
#const int LED_BANK = 0x002;         // device 0, register 2: LED bank
#const int INPUT_BOARD = 0x301; // device 3, register 1: input board

// Bit mapping for the 6 buttons (active-low)
#const int BTN1 = 1 << 2;  // 0x04
#const int BTN2 = 1 << 3;  // 0x08
#const int BTN3 = 1 << 4;  // 0x10
#const int BTN4 = 1 << 5;  // 0x20
#const int BTN5 = 1 << 6;  // 0x40
#const int BTN6 = 1 << 7;  // 0x80

 // Initialize button library
btn_init();

while (true) {

  // btn_getPressedEdges() returns a bitmask of buttons
  // that have just been pressed since the last poll.
  int pressed = btn_getPressedEdges(INPUT_BOARD);

  if ((pressed & BTN1) != 0)      DigitalWrite(LED_BANK, 1);
  else if ((pressed & BTN2) != 0) DigitalWrite(LED_BANK, 2);
  else if ((pressed & BTN3) != 0) DigitalWrite(LED_BANK, 3);
  else if ((pressed & BTN4) != 0) DigitalWrite(LED_BANK, 4);
  else if ((pressed & BTN5) != 0) DigitalWrite(LED_BANK, 5);
  else if ((pressed & BTN6) != 0) DigitalWrite(LED_BANK, 6);

  // When no button is pressed, turn LEDs off
  int stable = btn_readStable(INPUT_BOARD);
  if (((~stable) & (BTN1|BTN2|BTN3|BTN4|BTN5|BTN6)) == 0) {
    DigitalWrite(LED_BANK, 0);
  }

  // Wait for next sample
  delay(10); // 10 ms sampling -> debounce ~30 ms with DB_N=3
}
