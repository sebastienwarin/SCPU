void main() {
  // Init 128x64 @ 0x3C
  oled_begin(OLED_ADDR_0x3C, 128, 64);
  oled_clear();

  // Draw full-screen bitmap via pointer
  oled_drawBitmap(0, 0, 128, 64, &scpuBitmap);

  // Pause, then start a gentle left scroll across all pages
  delay(1500);
  oled_scroll_left(0, 7, 1);   // pages 0..7, speed 1

  // Let it scroll a while
  delay(5000);

  // Stop scroll and show the logo again (centered already)
  oled_scroll_stop();
}

main();
