// =============================================================================
// S-CODE SAMPLE - WEATHER STATION
// =============================================================================
// What it does:
//   Combines a clock, environmental readings, light readings, buttons, and an
//   LED animation into a three-screen interactive application.
// Expected result:
//   Buttons cycle through clock, BME280, and TSL2561 screens on the LCD while the
//   LED chaser continues to run.
// Runs on:
//   S-CPU TTL with LCD2004, input board, LEDs, DS3231, BME280, and TSL2561.
// Real hardware required:
//   Yes. The complete peripheral setup is not emulated by the simulators.
// Demonstrates:
//   Multi-driver integration, screen state, periodic tasks, and user input.
// =============================================================================
#include "core/Delay"
#include "core/Print"
#include "io/Buttons"
#include "io/DigitalWrite"

#include "drivers/HD44780"
#include "drivers/DS3231"
#include "drivers/TSL2561"
#include "drivers/BME280"

// I/O helpers add IODEV internally, so these values are MMIO offsets.
#const int INPUT_BOARD = 0x301; // device 3, register 1
#const int LED_BANK = 0x002;     // device 0, register 2

// Button masks (active-low, debounced by io/Buttons).
#const int BTN_PREVIOUS   = 1 << 2; // physical button 1
#const int BTN_NEXT       = 1 << 5; // physical button 4
#const int BTN_TOGGLE_LED = 1 << 7; // physical button 6

// LED pattern (Knight Rider)
const int ledPattern[] = { 8, 4, 2, 1, 2, 4 };

// Screens
#const int SCREEN_COUNT = 3;
int screenIndex = 0;

// State
int  ledIndex = 0;
bool ledBlink = true;

void PrintTwoDigits(int value) {
  if (value < 10) PrintChar('0');
  PrintDigits(value);
}

// Render current screen
void drawScreen(bool redrawAll) {
  if(redrawAll) {
    lcd_clear();
    // Line 0: Hello S-CPU
    lcd_setCursor(4,0);
    Print("Hello S-CPU!");
  }

  switch(screenIndex) {
    case 0:
      // Update RTC clock
      rtc_update();

      // line 2 : HH:MM:SS
      lcd_setCursor(6, 2);
      PrintTwoDigits(rtc_hour); PrintChar(':');
      PrintTwoDigits(rtc_min);  PrintChar(':');
      PrintTwoDigits(rtc_sec);

      // line 3 : JJ/MM/20YY
      lcd_setCursor(5, 3);
      PrintTwoDigits(rtc_day); PrintChar('/');
      PrintTwoDigits(rtc_mon); PrintChar('/');
      Print("20"); PrintTwoDigits(rtc_year);

      break;

    case 1:
      // temp/humidity/pressure
      bme_update();
    
      // Line 1: raw T
      lcd_setCursor(2, 1);
      Print("Temperature: "); PrintNumber(bme_rawTemp());

      // Line 2: raw H
      lcd_setCursor(4, 2);
      Print("Humidity: "); PrintNumber(bme_rawHum());

      // Line 3: Pressure
      lcd_setCursor(4, 3);
      Print("Pressure: "); PrintNumber(bme_rawPress());

      break;

    case 2:
      // light sensor
      tsl_update();           // refresh internal CH0/CH1
      int lux = tsl_lux();    // calculate lux

      // Line 2: LUX
      lcd_setCursor(5, 1); 
      if (lux > 0) {
        Print("LUX: "); PrintNumber(lux);
      } else {
        Print("LUX: N/A");
      }
      
       // Line 2: CH0 raw channels
      lcd_setCursor(5, 2);
      Print("CH0: "); PrintNumber(tsl_ch0);

       // Line 3: CH1 raw channels
      lcd_setCursor(5, 3);
      Print("CH1: "); PrintNumber(tsl_ch1);

      break;
  }
}

// --- Init ---
lcd_begin();
btn_init();
rtc_begin(RTC_DS3231_ADDR);
tsl_begin(TSL2561_ADDR_FLOAT);
tsl_setSettings(TSL2561_INTEGRATIONTIME_402MS, TSL2561_GAIN_16X);
bme_begin(BME280_ADDR_SDO_LOW);
drawScreen(true);

// --- Main loop ---
int tick = 0;
while (true) {

  // One-shot button events
  int edges = btn_getPressedEdges(INPUT_BOARD);
  if ((edges & BTN_PREVIOUS) != 0) {
    screenIndex = (screenIndex == 0) ? (SCREEN_COUNT - 1) : (screenIndex - 1);
  }
  else if ((edges & BTN_NEXT) != 0) {
    screenIndex = (screenIndex + 1) % SCREEN_COUNT;
  }
  else if ((edges & BTN_TOGGLE_LED) != 0) {
    ledBlink = !ledBlink;
  }

  // Refresh every 100ms or on user input
  if (++tick >= 10 || edges != 0) {
    tick = 0;

    // LEDs
    DigitalWrite(LED_BANK, ledBlink ? ledPattern[ledIndex++] : 0);
    if (ledIndex >= sizeof(ledPattern)) ledIndex = 0;

    // Screen
    drawScreen(edges != 0);
  }

  delay(10); // ~10 ms tick
}
