// =============================================================================
// S-CODE SAMPLE - ARRAYS AND POINTERS
// =============================================================================
// What it does:
//   Iterates over an array to compute a checksum and dereferences a pointer.
// Expected result:
//   The terminal prints "checksum = 42" followed by "pointer = 42".
// Runs on:
//   Desktop/CLI simulators and S-CPU targets with the TTY device.
// Demonstrates:
//   Array initialization/indexing, sizeof, address-of, and dereference.
// =============================================================================

#include "core/Print"
#include "drivers/TTY"

void main() {
  // An array occupies consecutive RAM words; sizeof returns its element count.
  static int values[] = { 6, 9, 12, 15 };
  int checksum = 0;

  for (int i = 0; i < sizeof(values); i++) {
    checksum += values[i];
  }

  int answer = 42;
  int* pointer = &answer;        // &: take the address of a variable
  int pointedValue = *pointer;  // *: read the value stored at that address

  Print("checksum = ");
  PrintNumber(checksum);
  Print("\npointer = ");
  PrintNumber(pointedValue);
  Print("\n");
}

main();
